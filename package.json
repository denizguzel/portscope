{
  "name": "portscope-dev",
  "displayName": "PortScope Dev",
  "version": "0.1.0",
  "description": "Shows the dev servers of this VS Code window in the status bar and opens them in one click.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/denizguzel/portscope.git"
  },
  "publisher": "scriptdock",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun run build:extension",
    "build:extension": "tsc -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint && bun run typecheck && bun run knip && bun run format:check",
    "lint:fix": "oxlint --fix && bun run format",
    "package:check": "bun run format && bun run lint && bun run build",
    "package:vsix": "bun run package:check && vsce package --out portscope-dev.vsix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "tsc --watch -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.1.0",
    "knip": "6.45.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "portScope.open",
        "title": "Open Dev Server",
        "category": "PortScope"
      },
      {
        "command": "portScope.copyUrl",
        "title": "Copy Dev Server URL",
        "category": "PortScope"
      },
      {
        "command": "portScope.stop",
        "title": "Stop Dev Server",
        "category": "PortScope"
      },
      {
        "command": "portScope.forceStop",
        "title": "Force Stop Dev Server (SIGKILL)",
        "category": "PortScope"
      }
    ],
    "configuration": {
      "title": "PortScope",
      "properties": {
        "portScope.refreshIntervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "How often PortScope scans for dev servers while the window is focused."
        },
        "portScope.healthCheck": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send a `HEAD /` request to each dev server to tell a server that answers (green) from one that is only bound (yellow). A server that answered is not asked again. Turn this off if you do not want any extra request in your dev server logs."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "resources/portscope-icon.png",
  "engines": {
    "vscode": "^1.141.2"
  },
  "packageManager": "bun@1.4.4"
}
